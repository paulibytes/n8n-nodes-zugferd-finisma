{
	"name": "n8n-nodes-zugferd-finisma",
	"version": "0.3.0",
	"description": "n8n node for e-invoices (ZUGFeRD, Factur-X, XRechnung, EN 16931), partner checks, SEPA payment files (pain.001) and bank statements (camt) via the finisma API",
	"license": "MIT",
	"homepage": "https://github.com/paulibytes/n8n-nodes-zugferd-finisma#readme",
	"keywords": [
		"n8n-community-node-package",
		"zugferd",
		"factur-x",
		"xrechnung",
		"en-16931",
		"e-invoice",
		"einvoice",
		"e-rechnung",
		"invoice",
		"germany",
		"finisma",
		"sepa",
		"pain.001",
		"camt",
		"bank-statement",
		"vies"
	],
	"author": {
		"name": "Paulibytes UG",
		"email": "info@paulibytes.de"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paulibytes/n8n-nodes-zugferd-finisma.git"
	},
	"bugs": {
		"url": "https://github.com/paulibytes/n8n-nodes-zugferd-finisma/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FinismaApi.credentials.js",
			"dist/credentials/FinismaOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Zugferd/ZugferdFinisma.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.0",
		"@types/node": "20.19.43",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
